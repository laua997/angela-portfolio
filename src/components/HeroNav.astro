---
import { isCurrent, page, site } from "../lib/content";
---

<nav class="hero-nav" aria-label="Primary">
  {
    site.nav.map((item) => {
      const active = isCurrent(Astro.url.pathname, item.href);
      return (
        <a class="slide-link" data-label={item.label} href={page(item.href)} aria-current={active ? "page" : undefined}>{item.label}</a>
      );
    })
  }
</nav>
