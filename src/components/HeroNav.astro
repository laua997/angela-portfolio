---
import { page, site } from "../lib/content";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const homePath = page("").replace(/\/$/, "");
---

<nav class="hero-nav" aria-label="Primary">
  {
    site.nav.map((item) => {
      const url = page(item.href).replace(/\/$/, "") || "/";
      const active =
        url === current ||
        (item.href === "" && current === homePath) ||
        (item.href === "projects" && current.startsWith(`${url}/`));
      return (
        <a href={page(item.href)} aria-current={active ? "page" : undefined}>
          {item.label}
        </a>
      );
    })
  }
</nav>
