---
import Base from "../layouts/Base.astro";
import HeroNav from "../components/HeroNav.astro";
import { asset, site } from "../lib/content";
---

<Base title="About - Angela Lau Portfolio">
  <main id="main">
    <section class="wrap hero">
      <h1 class="appear appear-lg appear-d1">about.</h1>
      <div class="hero-side appear appear-d2">
        <HeroNav />
        <p class="about-quote">
          {site.about.quote[0]}<br />
          {site.about.quote[1]}
        </p>
      </div>
    </section>
    <section class="wrap about-grid">
      <img class="reveal" src={asset(site.portrait.src)} alt={site.portrait.alt} />
      <div class="about-copy reveal">
        {site.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <div class="about-links">
          <a class="text-link" href={site.links.resume} target="_blank" rel="noreferrer">resume</a>
          <a class="text-link" href={site.links.linkedin} target="_blank" rel="noreferrer">linkedin</a>
        </div>
      </div>
    </section>
  </main>
</Base>
