---
import Base from "../../layouts/Base.astro";
import HeroNav from "../../components/HeroNav.astro";
import { asset, getProjects, page, workGroup } from "../../lib/content";

const projects = getProjects();
---

<Base title="Work - Angela Lau Portfolio">
  <main id="main" class="work-main">
    <section class="wrap hero">
      <div class="appear appear-lg appear-d1">
        <h1 class="tangents home-work-title">work</h1>
        <div class="home-filters" data-filters data-filters-home>
          <button type="button" data-filter="all" aria-pressed="true">all</button>
          <button type="button" data-filter="fine art" aria-pressed="false">fine art</button>
          <button type="button" data-filter="events" aria-pressed="false">events</button>
        </div>
      </div>
      <div class="hero-side appear appear-d2">
        <HeroNav />
      </div>
    </section>
    <section class="wrap">
      <div class="work-board">
        {
          projects.map((project) => (
            <a
              class="home-card reveal"
              data-cursor="explore"
              data-category={workGroup(project.category)}
              href={page(`projects/${project.slug}`)}
            >
              <img src={asset(project.cover)} alt={project.title} />
              <span class="home-card-label">{workGroup(project.category)}</span>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</Base>
