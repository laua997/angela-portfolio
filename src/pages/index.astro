---
import Base from "../layouts/Base.astro";
import DotPortrait from "../components/DotPortrait.astro";
import { asset, getFeatured, page, site, workGroup } from "../lib/content";

const featured = getFeatured();
const places = ["miya", "flow", "vis"];
const nameSvgs = ["images/name-v1.svg", "images/name-v2.svg", "images/name-v3.svg"].map((file) => asset(file));
---

<Base>
  <div
    class="opener"
    data-opener
    data-script={asset("images/portfolio-script.svg")}
    data-names={nameSvgs.join("|")}
    aria-hidden="true"
  >
    <div class="opener-stage" data-opener-stage>
      <canvas class="opener-canvas" data-opener-canvas width="1440" height="1024"></canvas>
      <DotPortrait class="opener-face" />
      <div class="opener-name-slot">
        <p class="opener-name tangents" data-opener-name>angela lau.</p>
      </div>
      <img class="opener-script" data-opener-script src={asset("images/portfolio-script.svg")} alt="" />
    </div>
  </div>

  <main id="main" class="home-main">
    <header class="home-top wrap">
      <div class="home-work">
        <h2 class="tangents home-work-title"><a href={page("projects")}>work</a></h2>
      </div>

      <div class="home-identity">
        <p class="home-blurb home-blurb-left">artist. a fan of all things creative.</p>
        <div class="home-mark">
          <DotPortrait class="home-face" />
          <h1 class="tangents home-name" data-home-name>angela lau.</h1>
        </div>
        <p class="home-blurb home-blurb-right">aspiring creative director.</p>
      </div>

      <nav class="home-nav tangents" aria-label="Primary">
        <a href={page("about")}>about</a>
        <a href={page("contact")}>contact</a>
        <a href={site.links.linkedin} target="_blank" rel="noreferrer">linkedin</a>
      </nav>
    </header>

    <div class="wrap featured">
      <div class="featured-grid">
        {
          featured.map((project, index) => (
            <div class={`place-${places[index] ?? "miya"}`}>
              <a class="home-card" data-cursor="explore" href={page(`projects/${project.slug}`)}>
                <img src={asset(project.cover)} alt={project.title} />
                <span class="home-card-label">{workGroup(project.category)}</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </main>
</Base>

<script>
  import "../scripts/intro.js";
</script>
